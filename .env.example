# PaperProof Environment Configuration
# Copy to backend/.env (or root .env) and fill in your values

# Google Gemini API Key (leave empty to run in automatic heuristic mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key-in-production
JWT_EXPIRE_MINUTES=10080

# Optional: Google OAuth Client ID (for "Continue with Google")
GOOGLE_CLIENT_ID=

# Polite contact email for CrossRef / OpenAlex / Semantic Scholar User-Agent
CONTACT_EMAIL=team@paperproof.app

# Database URL (defaults to local SQLite file)
DATABASE_URL=sqlite:///./paperproof.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
